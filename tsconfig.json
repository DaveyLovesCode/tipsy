{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["svelte", "vite/client"],
    "paths": {
      "tipsy": ["./src/index.ts"]
    },
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "test/**/*", "site/src/**/*"]
}
